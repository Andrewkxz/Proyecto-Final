[Inmobiliaria|-arbolInmueblesPorPrecio:BinarySearchTree(Inmueble);-arbolClientesPorPresupuesto:BinarySearchTree(Cliente);-usuariosSistema:HashTable(String,Usuario);-inmueblesPorCodigo:HashTable(String,Inmueble);-clientesPorId:HashTable(String,Cliente);-asesoresPorId:HashTable(String,Asesor);-inmueblesAgrupadosPorCiudad:HashTable(String,LinkedSimpleList(Inmueble));-inmueblesAgrupadosPorTipo:HashTable(String,LinkedSimpleList(Inmueble));-inmueblesAgrupadosPorEstado:HashTable(String,LinkedSimpleList(Inmueble));-contadorCambiosPrecio:HashTable(String,Integer);-grafoRelaciones:Graph(String);-catalogoInmuebles:DoublyLinkedList(Inmueble);-clientes:LinkedSimpleList(Cliente);-asesores:LinkedSimpleList(Asesor);-operacionesRealizadas:LinkedSimpleList(Operacion);-historialVisitasGlobales:LinkedSimpleList(Visita);-colaTareasAdministrativas:Queue(String);-colaSolicitudesClientes:Queue(String);-colaClientesVIP:PriorityQueue(Cliente);-colaVisitasPendientes:PriorityQueue(Visita);-colaAlertasSistema:PriorityQueue(Alerta);-pilaHistorialCambios:Stack(CambioEstado)]

[Usuario|-username:String;-password:String;-rol:String;-idAsociado:String]

[Cliente|-id:String;-nombre:String;-correo:String;-telefono:String;-tipoCliente:String;-presupuesto:double;-tipoInmuebleDeseado:String;-minHabitaciones:int;-estadoBusqueda:String]

[Asesor|-id:String;-nombre:String;-contacto:String;-especialidadZona:String;-cargaTrabajoActiva:int;-numeroCierres:int]

[<<abstract>>;Inmueble|-codigo:String;-direccion:String;-ciudad:String;-barrioZona:String;-finalidad:String;-precio:double;-area:double;-habitaciones:int;-baños:int;-estado:String;-disponibilidad:boolean]

[Apartamento|-tieneAscensor:boolean;-valorAdministracion:double]

[Casa|-tieneGaraje:boolean]

[Oficina|-numeroCubiculos:int]

[LocalComercial|-frenteCalle:boolean;-categoria:String]

[Lote|-tieneServiciosPublicos:boolean]

[Bodega|-capacidadAlmacenamiento:double]

[Visita|-idVisita:String;-fecha:LocalDate;-hora:LocalDateTime;-estadoVisita:String;-observaciones:String;-nivelUrgencia:int]

[Operacion|-id:String;-fecha:LocalDate;-tipoOperacion:String;-valorAcordado:double;-comision:double;-estadoProceso:String]

[Alerta|-idAlerta:String;-mensaje:String;-tipoAlerta:String;-nivelPrioridad:int;-fechaGeneracion:LocalDate;-revisada:boolean]

[CambioEstado|-tipoCambio:int;-entidad:Object;-descripcionAccion:String;-disponibilidadAnterior:boolean;-estadoAnterior:String;-precioAnterior:double]

